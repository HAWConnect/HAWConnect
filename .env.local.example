# HAWConnect public endpoints. Use HTTPS outside localhost.
EXPO_PUBLIC_HAWCONNECT_GRAPHQL_ENDPOINT="http://localhost:4000/graphql"
EXPO_PUBLIC_HAWCONNECT_AUTH_URL=http://localhost:4000/api/accounts
# University login is unavailable. Optional HAWConnect accounts are separate from myHAW.
# Configure club-owned services only after they exist; do not copy upstream credentials.

# Optional club-controlled public links. Leave blank until configured.
EXPO_PUBLIC_WEBSITE_URL=
EXPO_PUBLIC_SOURCE_REPOSITORY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_DOWNLOAD_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_IMPRINT_URL=
EXPO_PUBLIC_FAQ_URL=
EXPO_PUBLIC_STATUS_URL=

# Club-owned Expo project UUID, also set in the EAS preview environment for TestFlight.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional MapLibre styles. Blank uses public OpenFreeMap defaults.
EXPO_PUBLIC_MAP_STYLE_LIGHT_URL=
EXPO_PUBLIC_MAP_STYLE_DARK_URL=
